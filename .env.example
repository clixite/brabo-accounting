# BRABO frontend env (copy to .env and fill real values)
VITE_API_URL=https://api.brabo.clixite-prod.cloud
VITE_API_TOKEN=change-me

# OCR serveur (optionnel — résolution automatique sinon)
# 1. Vide : OCR via l'API Express (/api/ocr/*, token partagé) si VITE_API_URL est défini ;
#    sinon serveur OCR local http://localhost:8000 (dev).
# 2. Surcharge explicite (dev direct, sans Express) :
# VITE_OCR_API_URL=http://localhost:8000
